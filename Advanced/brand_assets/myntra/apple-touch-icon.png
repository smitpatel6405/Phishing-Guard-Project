      var whiteListKeys = [
        /^pwaInstalled$/,
        /^mobileNumber$/,
        /^urt$/,
        /^lastLogout$/,
        /^twa$/,
        /^hideA2hsCard$/,
        /^a2hsIconShake$/,
        /^FeedCardView$/,
        /^pdpAutoWishlist$/,
        /^address$/,
        /^RECOVERY_DATA:/,
