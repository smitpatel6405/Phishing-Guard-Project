rns","body":{"cardReturn":"Go to &lt;strong&gt;Menu&lt;/strong&gt; > &lt;strong&gt;My Orders&lt;/strong&gt; > &lt;strong&gt;Return&lt;/strong&gt; and select the time slot and mode for return","cardAgentCustomer":"Delivery agent will pick up the product","cardCash":"Refund will be processed in 7-14 days after the quality check"},"footer":"&lt;strong&gt;Note:&lt;/strong&gt; The product should not be damaged and the price tags should be intact. T&C applicable"},"exchange":{"header":"Easy Exchanges","desktopHeader":"Easy Exchanges","body":{"cardExchange":"Go to &lt;strong&gt;Menu&lt;/strong&gt; > &lt;strong&gt;My Orders&lt;/strong&gt; > &lt;strong&gt;Exchange&lt;/strong&gt; and select the time slot for exchange","cardAgentCustomer":"Delivery agent will deliver the new product and pick up the old one","cardAgentDeliver":"No additional payment needed"},"footer":"&lt;strong&gt;Note:&lt;/strong&gt; The product should not be damaged and the price tags should be intact. T&C applicable"},"try":{"header":"How does Try and Buy work?","desktopHeader":"Try and Buy","body":{"cardTry":"Select option &lt;strong&gt;&quot;Try and Buy&quot;&lt;/strong&gt; in the address confirmation page","cardAgentCustomer":"Delivery agent waits while you try the items","cardClothes":"Keep the items you like and return the rest to the agent","cardCash":"Pay only for what you keep (for pay on delivery orders) or get refunded for the ones returned (for prepaid orders)"},"footer":"&lt;strong&gt;Ordering for the first time?&lt;/strong&gt; You can also avail COD with Try &amp; Buy and pay only for what you keep. T&C applicable"},"differentialReturns":{"enable":false,"header":"How hassle free 15 day return works","desktopHeader":"Hassle free 15 day returns","body":{"bpcReturnRequest":"&lt;h6&gt;Raise Return Request&lt;/h6&gt;&lt;p&gt;Go to ‘My Orders’ section and click on return on a wrong, defective or expired product&lt;/p&gt;","bpcRequestApproval":"&lt;h6&gt;Request Approval&lt;/h6&gt;&lt;p&gt;Once the request is raised, it’ll be evaluated within 3 business days.&lt;/p&gt;","bpcRefund":"&lt;h6&gt;Refund&lt;/h6&gt;&lt;p&gt;The amount will be refunded to the selected mode once the product is picked up and physically evaluated*&lt;/p&gt;"},"footer":"&lt;p style='color:#ff5722';&quot;&gt;*In case of self ship, courier the item to the nearest warehouse. Check FAQ for details&lt;/p&gt;","images":{"bpcReturnRequest":"https://assets.myntassets.com/assets/images/2021/5/24/df66b668-d952-4881-a2ae-7041c96043861621846711169-return_request.png","bpcRequestApproval":"https://assets.myntassets.com/assets/images/2021/5/24/cd09461f-7511-4a0b-acc0-dfd3351f75f01621848256046-request_approval.png","bpcRefund":"https://assets.myntassets.com/assets/images/2021/5/24/2a615c32-116e-4491-92e2-e79205d071421621848162720-refund.png","differentialReturns":"https://constant.myntassets.com/pwa/assets/img/differential-returns-icon.png"}}},"pwaNewUserOnboarding.banners":{"trustBuilders":{"trustOriginal":"Genuine Products","trustQuality":"7 Step Quality Check","trustSecure":"Secure Payments"},"newUsersPDP":{"title":"Upto 300 Off ","description":"Applicable on your first order.&lt;br/&gt; Use code: MYNTRA300"},"exchangeReturn":{"return":{"title":"Easy 14 days returns","description":"Choose to return within 14 days."},"exchange":{"title":"Easy 14 days exchange","description":"Choose to exchange for a different size (if available) within 14 days."},"returnAndExchange":{"title":"Easy 14 days returns and exchange","description":"Choose to return or exchange for a different size (if available) within 14 days."},"noReturnAndExchange":{"title":"Return and Exchange not available","description":"Items like innerwear, socks, certain accessories and some high-value fragile items do not come under our return/exchange policy."},"differentialReturns":{"title":"Hassle Free returnPeriod Day Return","description":"You can return the product within returnPeriod days if the delivered product is damaged, expired, differen